{
  "name": "W3 - FlowGuard BROKEN learning starter",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "parameters": {}
    },
    {
      "id": "seed-batch",
      "name": "Seed Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{events:[{event_id:'FG1',amount_minor:1200},{event_id:'FG2',amount_minor:-1}]}}];"
      }
    },
    {
      "id": "broken-submit",
      "name": "Broken Submit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8013/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event_id: 'run-' + $execution.id, amount_minor: $json.amount_minor} }}",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "false-success",
      "name": "False Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{status:'succeeded',message:'All done'}}];"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Seed Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seed Batch": {
      "main": [
        [
          {
            "node": "Broken Submit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Broken Submit": {
      "main": [
        [
          {
            "node": "False Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
