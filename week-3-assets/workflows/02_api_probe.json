{
  "name": "W3 - API Probe",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "parameters": {}
    },
    {
      "id": "seed-event",
      "name": "Seed Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{event_id:'E101',amount_minor:1200,mode:'normal'}}];"
      }
    },
    {
      "id": "submit-event",
      "name": "Submit Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8013/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Seed Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seed Event": {
      "main": [
        [
          {
            "node": "Submit Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok"
  },
  "pinData": {}
}
